#Conexión a postgresql
DATABASE_URL="postgresql://user:password@localhost:5432/database"

#Server
PORT=3000

#Origen del frontend para el CORS
FRONTEND_ORIGIN="http://localhost:5173"

#JWT (el secreto debe tener al menos 32 caracteres)
JWT_SECRET="REPLACE-THIS-WITH-RANDOM-32-PLUS-CHARS"
JWT_EXPIRES_IN_SECONDS=3600

# bcrypt valor entre 10 y 15, mientras más rondas más lento
BCRYPT_ROUNDS=10

# Datos del primer admin (solo los usa el seed)
# Si el seed se hardcodea se reduce la seguridad, porque la contraseña está en alguna parte del código
SEED_ADMIN_NAME="Administrador"
SEED_ADMIN_EMAIL="admin@gimnasio.com"
SEED_ADMIN_PHONE="60000000"
SEED_ADMIN_PASSWORD="1234"